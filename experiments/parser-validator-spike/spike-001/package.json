{
  "name": "oait-parser-validator-spike-001",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "run:scalar": "node --import tsx scalar/index.ts",
